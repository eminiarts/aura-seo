{
    "name": "eminiarts/aura-seo",
    "description": "Free Resource-first SEO essentials for Aura CMS.",
    "keywords": [
        "aura",
        "aura-cms",
        "laravel",
        "metadata",
        "robots",
        "seo",
        "sitemap"
    ],
    "homepage": "https://aura-cms.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Emini Arts GmbH",
            "email": "support@eminiarts.ch",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-xmlwriter": "*",
        "eminiarts/aura-cms": "^1.0",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "intervention/image-laravel": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/framework": "^12.0|^13.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.1|^9.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.1|^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "suggest": {
        "eminiarts/aura-redirects": "Manage redirect records independently from Aura SEO."
    },
    "autoload": {
        "psr-4": {
            "Aura\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aura\\Seo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aura\\Seo\\AuraSeoServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../aura-cms",
            "options": {
                "symlink": true,
                "versions": {
                    "eminiarts/aura-cms": "1.0.0"
                }
            }
        }
    ],
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
